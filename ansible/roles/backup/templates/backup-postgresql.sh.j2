#!/usr/bin/env bash
set -euo pipefail
umask 077

backup_directory="{{ postgresql_backup_directory }}"
database_name="{{ postgresql_application_database }}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary_backup="${backup_directory}/.${database_name}-${timestamp}.dump"
final_backup="${backup_directory}/${database_name}-${timestamp}.dump"

cleanup() {
    rm -f "${temporary_backup}"
}
trap cleanup EXIT

pg_dump --format=custom --compress=6 \
    --file="${temporary_backup}" "${database_name}"
mv "${temporary_backup}" "${final_backup}"
sha256sum "${final_backup}" > "${final_backup}.sha256"

find "${backup_directory}" -type f \
    \( -name '*.dump' -o -name '*.dump.sha256' \) \
    -mtime +{{ postgresql_backup_retention_days }} -delete
